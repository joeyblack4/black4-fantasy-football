    "bone":    { "hex": "#F5F1E8", "role": "surface",   "meaning": "drafting paper / clarity" },
    "graphite":{ "hex": "#0B0C24", "role": "ink",       "meaning": "outline / monogram contrast" },
    "violet":  { "hex": "#252774", "role": "highlight", "meaning": "gradient midpoint" }
  },
  "typography": {
    "display": { "family": "Georgia, 'Times New Roman', serif", "use": "wordmark, strap, body intro" },
    "mono":    { "family": "ui-monospace, 'JetBrains Mono', Menlo, monospace", "use": "receipts, stats, citations" }
  },
  "motifs": [
    "shield with dashed coral inner ring (football arc + workshop plate)",
