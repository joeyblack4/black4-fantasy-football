#!/bin/sh
# Buzz owns this PID and all runtime controls; exec preserves that ownership.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${BUZZ_RELAY_URL:-}" != 'wss://black4fantasysports.communities.buzz.xyz' ]; then
  echo 'Black4 franchise belongs to the fantasy community; no runtime started here.' >&2
  exit 0
fi
FRANCHISE=${BUZZ_ACP_AGENT_ARGS##*,}
case "$FRANCHISE" in
  b4-openai|b4-anthropic|b4-google|b4-xai|b4-qwen|b4-mistral|b4-kimi|b4-meta|b4-deepseek|b4-zai|b4-minimax) ;;
  *) echo 'Missing recognized native franchise argument' >&2; exit 2;;
esac
cd "$ROOT/franchises/${FRANCHISE#b4-}/workspace"
export B4_NATIVE_WORKSPACE="$PWD"
unset BUZZ_ACP_CHANNELS
# League owners accept peer collaboration and infrastructure appointments.
# Keep this explicit so desktop defaults cannot silently isolate a franchise.
export BUZZ_ACP_RESPOND_TO=anyone
if [ "$FRANCHISE" = b4-qwen ]; then
  # Rotate between bounded assignments; retain private files and native memory.
  # New mentions wait instead of extending the active assignment.
  export BUZZ_ACP_MAX_TURNS_PER_SESSION=1
  export BUZZ_ACP_MULTIPLE_EVENT_HANDLING=queue
  export BUZZ_ACP_IDLE_TIMEOUT=300
  export BUZZ_ACP_MAX_TURN_DURATION=900
  exec "$ROOT/.local/tooling/qwen-recovery/buzz-acp" "$@"
fi
exec "$ROOT/.local/tooling/bin/buzz-acp" "$@"
